{"title":"[${environment_upper}] Oficina - Ordens de Servico","description":"Volume, tempos de ciclo e erros de integracao.","layout_type":"ordered","tags":["team:oficina"],"widgets":[{"definition":{"type":"timeseries","title":"Volume diario de OS","requests":[{"q":"max:oficina.os.volume_daily{env:${environment}}","display_type":"bars"}]}},{"definition":{"type":"query_value","title":"Tempo medio em diagnostico (h)","autoscale":true,"precision":2,"requests":[{"q":"avg:oficina.os.duration.diagnostico_hours{env:${environment}}","aggregator":"last"}]}},{"definition":{"type":"query_value","title":"Tempo medio em execucao (h)","autoscale":true,"precision":2,"requests":[{"q":"avg:oficina.os.duration.execucao_hours{env:${environment}}","aggregator":"last"}]}},{"definition":{"type":"query_value","title":"Tempo medio ate finalizacao (h)","autoscale":true,"precision":2,"requests":[{"q":"avg:oficina.os.duration.finalizacao_hours{env:${environment}}","aggregator":"last"}]}},{"definition":{"type":"timeseries","title":"Erros em OS","requests":[{"q":"sum:oficina.os.operation_errors{env:${environment}}.as_count()","display_type":"bars"}]}},{"definition":{"type":"timeseries","title":"Falhas de integracao/Function","requests":[{"q":"sum:aws.lambda.errors{env:${environment},service:oficina-auth}.as_count()","display_type":"bars"}]}}]}
