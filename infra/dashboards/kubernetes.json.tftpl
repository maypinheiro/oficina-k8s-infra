{"title":"[${environment_upper}] Oficina - Kubernetes","description":"Saude, capacidade e escalabilidade no EKS.","layout_type":"ordered","tags":["project:oficina","env:${environment}"],"widgets":[{"definition":{"type":"timeseries","title":"CPU dos pods","requests":[{"q":"avg:kubernetes.cpu.usage.total{env:${environment},kube_deployment:oficina-api} by {pod_name}","display_type":"line"}]}},{"definition":{"type":"timeseries","title":"Memoria dos pods","requests":[{"q":"avg:kubernetes.memory.usage{env:${environment},kube_deployment:oficina-api} by {pod_name}","display_type":"line"}]}},{"definition":{"type":"timeseries","title":"Replicas desejadas e disponiveis","requests":[{"q":"sum:kubernetes_state.deployment.replicas_desired{env:${environment},kube_deployment:oficina-api}","display_type":"line"},{"q":"sum:kubernetes_state.deployment.replicas_available{env:${environment},kube_deployment:oficina-api}","display_type":"line"}]}},{"definition":{"type":"timeseries","title":"Reinicializacoes","requests":[{"q":"sum:kubernetes.containers.restarts{env:${environment},kube_deployment:oficina-api} by {pod_name}.as_count()","display_type":"bars"}]}},{"definition":{"type":"timeseries","title":"HPA - replicas desejadas","requests":[{"q":"max:kubernetes_state.hpa.desired_replicas{env:${environment},horizontalpodautoscaler:oficina-api}","display_type":"line"}]}}]}
