{"title":"[${environment_upper}] Oficina - Operacao da API","description":"Latencia, throughput, erros e disponibilidade.","layout_type":"ordered","tags":["project:oficina","env:${environment}"],"widgets":[{"definition":{"type":"timeseries","title":"Latencia p95 por rota","requests":[{"q":"p95:trace.express.request.duration{env:${environment},service:oficina-api} by {resource_name}","display_type":"line"}]}},{"definition":{"type":"timeseries","title":"Throughput por rota","requests":[{"q":"sum:oficina.http.requests{env:${environment}} by {route}.as_count()","display_type":"bars"}]}},{"definition":{"type":"timeseries","title":"Erros HTTP 5xx","requests":[{"q":"sum:oficina.http.errors{env:${environment}} by {route}.as_count()","display_type":"bars"}]}},{"definition":{"type":"query_value","title":"Replicas disponiveis","autoscale":true,"precision":0,"requests":[{"q":"sum:kubernetes_state.deployment.replicas_available{env:${environment},kube_deployment:oficina-api}","aggregator":"last"}]}}]}
