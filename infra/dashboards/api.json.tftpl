{"title":"[${environment_upper}] Oficina - Operacao da API","description":"Latencia, throughput, erros e disponibilidade.","layout_type":"ordered","tags":["team:oficina"],"widgets":[{"definition":{"type":"timeseries","title":"Latencia p95 por rota (ms)","requests":[{"q":"p95:oficina.http.request.duration_ms{env:${environment}} by {route}","display_type":"line"}]}},{"definition":{"type":"timeseries","title":"Throughput por rota","requests":[{"q":"sum:oficina.http.requests{env:${environment}} by {route}.as_count()","display_type":"bars"}]}},{"definition":{"type":"timeseries","title":"Erros HTTP 5xx (sem dados = nenhum 5xx)","requests":[{"q":"sum:oficina.http.errors{env:${environment}} by {route}.as_count()","display_type":"bars"}]}},{"definition":{"type":"query_value","title":"Replicas disponiveis","autoscale":true,"precision":0,"requests":[{"q":"sum:kubernetes_state.deployment.replicas_available{env:${environment},kube_deployment:oficina-api}","aggregator":"last"}]}}]}
